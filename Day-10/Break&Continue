=================================break Statement============================

public class Main
{
	public static void main(String[] args) {
	    for(int i=1;i<=30;i++){
	        if(i==20){
	            break;
	        }
	        System.out.println(i);
	    }
	
	}
}

====================using Continue Statements-Skip even numbers========================

public class Main
{
	public static void main(String[] args) {
	    for(int i=1;i<=30;i++){
	        if(i%2==0){
	            continue;
	        }
	        System.out.println(i);
	    }
	
	}
}


