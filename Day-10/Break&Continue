==============stop at a number Divisible by 5 & 7 ==========================

public class Main
{
	public static void main(String[] args) {
	    for(int i=1;i<=100;i++){
	        if(i%5==0 && i%7==0){
	            break;
	        }
	        System.out.println(i);
	    }
	
	}
}



