=====================sum of numbers 1 to 100 using a while loop====================
public class Main{
    public static void main(String[] args){
        int n=100;
        int i=1;
        while(i<=n){
            System.out.println(i);
            i++;
        }
    }
}

=====================multiplication table for a number============================
import java.util.*;
public class Main
{
	public static void main(String[] args) {
	    Scanner sc=new Scanner(System.in);
	    int n=sc.nextInt();
	    for(int i=1;i<=10;i++){
	        System.out.println(n+"*"+i+"="+(n*i));
	    }
	}
}

